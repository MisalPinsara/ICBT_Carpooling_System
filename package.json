{
  "name": "icbt-carpooling-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "client": "cd client && vite --host 127.0.0.1 --port 5173 --strictPort",
    "server": "nodemon",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "npm --prefix server test",
    "build": "cd client && vite build",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "bcryptjs": "^2.4.3",
    "concurrently": "^9.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.8.0",
    "nodemon": "^3.1.4",
    "pdfkit": "^0.20.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "jest": "^29.7.0",
    "postcss": "^8.5.26",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {}
  }
}
